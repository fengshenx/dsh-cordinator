{
  "name": "dsh-coordinator",
  "version": "0.1.0",
  "description": "Coordinator/worker orchestration for DeepSeek Harness: protocol skills, project bootstrap, and a delivery board.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./src/host": "./src/host/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "src/**",
    "lib/client.js",
    "skills/**",
    "locale/*.json",
    "README.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js",
    "check": "for f in index.js $(find src scripts build \\( -name '*.js' -o -name '*.mjs' \\)); do node --check \"$f\" || exit 1; done && node --test tests/*.test.js",
    "build:client": "node build/client.mjs",
    "dev": "node scripts/dev.mjs",
    "worktree:spawn": "node scripts/worktree-spawn.mjs",
    "worktree:prune": "node scripts/worktree-prune.mjs",
    "prepublishOnly": "npm run build:client"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "orchestration",
    "coordinator"
  ],
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "minidenticons": "^4.2.1"
  }
}
